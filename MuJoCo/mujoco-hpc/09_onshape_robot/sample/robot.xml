<!-- A hand-written stand-in for what onshape-to-robot produces: a box with two driven wheels and a skid.
     Axle is toward the rear; the skid is at the front. Units: metres. -->
<mujoco model="robot">
  <compiler angle="radian"/>

  <worldbody>
    <body name="chassis" pos="0 0 0.05">
      <geom type="box" size=".1 .06 .025" rgba=".7 .7 .75 1"/>

      <geom name="skid" type="sphere" size=".015" pos=".08 0 -.035" rgba=".3 .3 .3 1"/>

      <body name="left_wheel_link" pos="-.04 .07 -.01">
        <joint name="left_wheel" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size=".04 .01" euler="1.5708 0 0" rgba=".9 .4 .1 1"/>
      </body>
      <body name="right_wheel_link" pos="-.04 -.07 -.01">
        <joint name="right_wheel" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size=".04 .01" euler="1.5708 0 0" rgba=".9 .4 .1 1"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="left_wheel" joint="left_wheel" kp="2" kv=".2" forcerange="-.2 .2"/>
    <position name="right_wheel" joint="right_wheel" kp="2" kv=".2" forcerange="-.2 .2"/>
  </actuator>
</mujoco>
