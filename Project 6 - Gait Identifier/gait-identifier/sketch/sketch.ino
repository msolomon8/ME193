// Gait Identifier - UNO Q MCU side.
// Samples an MPU-6050 (accelerometer + gyro) at 50 Hz into a ring buffer.
// Python on the Linux side collects new samples with Bridge.call("imu") and
// shows model 2's answer as an animated stick figure with Bridge.call("show", activity, frame_ms).
#include <Arduino_RouterBridge.h>
#include <Arduino_LED_Matrix.h>
#include <Wire.h>

// ---- IMU ----
const uint32_t SAMPLE_MS = 20;   // 50 Hz
const int RING = 200;            // 4 s of samples, plenty if Python is slow for a moment
const int MAX_PER_CALL = 50;

TwoWire *bus = nullptr;          // whichever bus the MPU-6050 answered on
uint8_t addr = 0;
int16_t ring[RING][6];           // ax ay az gx gy gz, raw counts
uint32_t head = 0;               // total samples taken (sequence number of the next one)
uint32_t tail = 0;               // sequence number of the next sample to hand to Python
uint32_t nextSample = 0;

void writeReg(uint8_t reg, uint8_t val) {
  bus->beginTransmission(addr);
  bus->write(reg);
  bus->write(val);
  bus->endTransmission();
}

bool findImu() {
  TwoWire *buses[] = {&Wire1, &Wire};   // Qwiic connector first, then the A4/A5 header
  uint8_t addrs[] = {0x68, 0x69};
  for (TwoWire *b : buses) {
    b->begin();
    b->setClock(400000);
    for (uint8_t a : addrs) {
      b->beginTransmission(a);
      if (b->endTransmission() == 0) {
        bus = b;
        addr = a;
        return true;
      }
    }
  }
  return false;
}

void setupImu() {
  writeReg(0x6B, 0x00);   // wake up
  delay(50);
  writeReg(0x1A, 0x03);   // low-pass filter ~44 Hz
  writeReg(0x1B, 0x18);   // gyro +-2000 deg/s (16.4 counts per deg/s)
  writeReg(0x1C, 0x18);   // accel +-16 g (2048 counts per g); running ankles can pass 8 g
}

bool readImu(int16_t out[6]) {
  bus->beginTransmission(addr);
  bus->write(0x3B);
  if (bus->endTransmission(false) != 0) return false;
  if (bus->requestFrom(addr, (uint8_t)14) != 14) return false;
  uint8_t b[14];
  for (int i = 0; i < 14; i++) b[i] = bus->read();
  out[0] = (b[0] << 8) | b[1];
  out[1] = (b[2] << 8) | b[3];
  out[2] = (b[4] << 8) | b[5];
  // b[6..7] is temperature
  out[3] = (b[8] << 8) | b[9];
  out[4] = (b[10] << 8) | b[11];
  out[5] = (b[12] << 8) | b[13];
  return true;
}

// "seq;ax,ay,az,gx,gy,gz;ax,..."  (seq = sequence number of the first sample)
// "NOIMU" if the sensor was not found.
String imu() {
  if (!bus) return String("NOIMU");
  if (head - tail > RING) tail = head - RING;   // Python fell behind: oldest samples are gone
  String s = String(tail);
  int n = 0;
  while (tail < head && n < MAX_PER_CALL) {
    int16_t *r = ring[tail % RING];
    s += ';';
    for (int i = 0; i < 6; i++) {
      if (i) s += ',';
      s += r[i];
    }
    tail++;
    n++;
  }
  return s;
}

