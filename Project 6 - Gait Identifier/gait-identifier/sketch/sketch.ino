// 5x7 symbols for when there is no figure to show, one byte per row, bit 4 = leftmost column
const uint8_t FONT[][7] = {
  {0x0E, 0x11, 0x01, 0x02, 0x04, 0x00, 0x04},   // ? no model yet
  {0x00, 0x00, 0x00, 0x1F, 0x00, 0x00, 0x00},   // - no IMU / waiting
};

int activity = 5;                // 0 standing, 1 walking, 2 running, 3 biking, 4 no model, 5 no IMU
uint32_t frameMs = 250;          // time per frame; 4 frames = one stride or pedal turn
int frameIdx = 0;
uint32_t lastFrame = 0;

void drawNow() {
  if (activity >= 0 && activity < 4) {
    matrix.draw((uint8_t *)ANIM[activity][frameIdx % N_FRAMES[activity]]);
    return;
  }
  memset(frame, 0, sizeof(frame));
  const uint8_t *g = FONT[activity == 4 ? 0 : 1];
  for (int r = 0; r < 7; r++)
    for (int c = 0; c < 5; c++)
      if (g[r] & (0x10 >> c)) frame[r * 13 + 4 + c] = 255;
  matrix.draw(frame);
}

// Python calls this when the activity or its pace changes.
void show(int act, int ms) {
  if (act != activity) frameIdx = 0;
  activity = act;
  frameMs = constrain(ms, 60, 2000);
  drawNow();
}

void animate() {
  uint32_t now = millis();
  if (activity < 4 && N_FRAMES[activity] > 1 && now - lastFrame >= frameMs) {
    lastFrame = now;
    frameIdx = (frameIdx + 1) % N_FRAMES[activity];
    drawNow();
  }
}

void setup() {
  matrix.begin();
  matrix.setGrayscaleBits(8);
  drawNow();

  if (findImu()) setupImu();

  Bridge.begin();
  Bridge.provide_safe("imu", imu);   // runs between loop() passes, so the ring buffer is never half-written
  Bridge.provide_safe("show", show);
}

void loop() {
  animate();
  if (!bus) return;
  uint32_t now = millis();
  if ((int32_t)(now - nextSample) < 0) return;
  nextSample = (now - nextSample > 100) ? now + SAMPLE_MS : nextSample + SAMPLE_MS;   // resync after a long stall
  if (readImu(ring[head % RING])) head++;
}
